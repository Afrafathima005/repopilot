# ==============================================================================
# Autonomous AI Software Engineering Agent — Environment Configuration Template
# ==============================================================================

# --- Application Core ---
ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- Database Setup (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db

# --- Cache and Queue Setup (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Vector Database Setup (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Git / GitHub Integrations ---
# GitHub personal access token (required for cloning private repos or avoiding rate limits)
GITHUB_TOKEN=your_github_token_here

# --- LLM Service Layer Abstraction ---
# Supported providers: "openai", "groq", "huggingface", "local"
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0

# Optional config for other providers (e.g. Groq, local)
# GROQ_API_KEY=
# GROQ_MODEL=llama3-70b-8192
# LOCAL_LLM_URL=http://localhost:11434/v1

# --- Sandbox and Agent Execution Limits ---
# Isolated sandbox execution configs
DOCKER_TIMEOUT_SEC=120
DOCKER_CPU_LIMIT=2.0
DOCKER_MEMORY_LIMIT=2g

# Maximum attempts the self-correction loop can execute before giving up
MAX_AGENT_ATTEMPTS=3

# --- Observability ---
# Track experiments and configurations
MLFLOW_TRACKING_URI=http://localhost:5000
ENABLE_RERANKING=false
